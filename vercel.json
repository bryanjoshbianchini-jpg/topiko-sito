{
 "buildCommand": "BOZZA=dist bash aggiorna-link.sh --prova",
 "outputDirectory": "dist",
 "installCommand": "",
 "framework": null,
 "headers": [
  {
   "source": "/(img|seq-logo|fonts|vendor)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), payment=()"
    }
   ]
  }
 ]
}
